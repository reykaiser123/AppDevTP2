<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="gatchapon.Characters"
             BackgroundColor="#ADC179"
             NavigationPage.HasNavigationBar="False">

    <Border BackgroundColor="#ADC179" StrokeThickness="0" Padding="25">
        <Grid RowDefinitions="Auto, Auto, *" RowSpacing="15">

            <Grid Grid.Row="0" 
                  BackgroundColor="#ADC179"
                  HeightRequest="60"
                  Padding="0,0">

                <ImageButton Source="back_icon.png"
                             HeightRequest="30"
                             WidthRequest="30"
                             HorizontalOptions="Start"
                             VerticalOptions="Center"
                             BackgroundColor="Transparent"
                             Clicked="OnBackClicked"/>

                <Label Text="CHARACTERS"
                       TextColor="White"
                       FontSize="22"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
            </Grid>

            <Border Grid.Row="1" 
                    BackgroundColor="#CEDCA1" 
                    StrokeShape="RoundRectangle 25" 
                    HeightRequest="50" 
                    StrokeThickness="0"
                    Padding="15,0">
                <Grid ColumnDefinitions="*, Auto">
                    <Entry Placeholder="Search Characters" 
                           PlaceholderColor="#7A855C" 
                           TextColor="#3B4728" 
                           FontSize="14"
                           VerticalOptions="Center"/>

                    <Image Source="search_icon.png" 
                           Grid.Column="1" 
                           HeightRequest="20" 
                           Opacity="0.5"/>
                </Grid>
            </Border>

            <CollectionView Grid.Row="2" 
                            SelectionMode="None" 
                            ItemsSource="{Binding CharacterList}">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="3" VerticalItemSpacing="15" HorizontalItemSpacing="10"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <VerticalStackLayout Spacing="5">

                            <Border HeightRequest="100" 
                                    WidthRequest="90" 
                                    BackgroundColor="#EFEDD3" 
                                    Stroke="{Binding BorderColor}" 
                                    StrokeThickness="3" 
                                    StrokeShape="RoundRectangle 15">

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCharacterTapped" CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>

                                <Image Source="{Binding Image}" 
                                       Aspect="AspectFill" 
                                       VerticalOptions="End" 
                                       Margin="0,10,0,0"/>
                            </Border>

                            <Label Text="{Binding Name}" 
                                   TextColor="#4A5238" 
                                   FontSize="12" 
                                   FontAttributes="Bold" 
                                   HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </Grid>
    </Border>
</ContentPage>