<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:gatchapon"
             xmlns:converters="clr-namespace:gatchapon.Converters"
             x:Class="gatchapon.App">

    <Application.Resources>
        <ResourceDictionary>

            <converters:IsFriendConverter x:Key="IsFriendConverter" />
            <converters:NotFriendConverter x:Key="NotFriendConverter" />
            <converters:FriendStatusToColorConverter x:Key="FriendStatusToColorConverter" />

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </Application.Resources>
</Application>